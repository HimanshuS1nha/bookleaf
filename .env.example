# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf

# Secret used to sign login tokens. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional. Log level for pino: trace, debug, info, warn, error. Defaults to info.
LOG_LEVEL=info
